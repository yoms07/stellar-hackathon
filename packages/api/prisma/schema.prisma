generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Wallet-auth nonces (D-001) and content file metadata. See docs/API_SPEC.md §4.
// The chain is the authority on money and entitlement — this is a filing cabinet.

model Nonce {
  id        String    @id @default(cuid())
  wallet    String
  nonce     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([wallet])
}

enum ContentStatus {
  DRAFT
  REGISTERED
}

// Added for prototype-parity (see docs/DECISIONS.md latest entry). Today's actual content is
// PDFs only (CLAUDE.md) — this enum exists so richer types can be added later without another
// migration. No course/video-specific business logic beyond storing the type + optional modules.
enum ContentType {
  PDF
  COURSE
  VIDEO
  EBOOK
  LINK
}

model Content {
  id            String        @id @default(cuid())
  contractId    String?       @unique // stringified u64, null until confirmed
  title         String
  description   String
  sha256        String        @unique
  storageKey    String
  sizeBytes     Int
  creatorWallet String
  status        ContentStatus @default(DRAFT)
  contentType   ContentType   @default(PDF)
  modules       Json? // array of { title: string }, COURSE-type only; unused otherwise
  createdAt     DateTime      @default(now())

  @@index([creatorWallet])
  @@index([status])
}

// Community brand (D-010): display-only identity a manager sets for their public community page
// (name, logo, description). Keyed by the manager's wallet. Not money or entitlement — the chain
// stays authority on those — but persisted here (not localStorage) so the community page is
// viewable by any visitor, not just the owner's browser.
model Community {
  wallet      String   @id
  name        String
  description String   @default("")
  logo        String? // small image as a data: URL, or null
  benefits    Json? // array of { title: string, description: string }, manager-editable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Per-wallet, per-content progress tracking (prototype parity: course modules, PDF read %).
// Not entitlement or money — purely a UX convenience layered on top of chain-verified access.
model Progress {
  id        String   @id @default(cuid())
  wallet    String
  contentId String // matches Content.contractId — stringified on-chain u64
  data      Json // { pct?: number, doneModules?: number[], lastViewedAt?: string }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wallet, contentId])
  @@index([wallet])
}
